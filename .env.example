# Copy to .env and fill in your key:
#   cp .env.example .env
#
# Only needed if using API key auth (pay-per-use).
# For Pro/Max subscription auth, use OAuth instead — see docker-compose.yml.
ANTHROPIC_API_KEY=sk-ant-...

