# Copy to .env and fill in values:
#   cp .env.example .env
#
# Authentication — pick one:
#   OAuth (Pro/Max): just run `claude` on the host to log in. Credentials
#     at ~/.claude/.credentials.json are mounted automatically. No env var needed.
#   API key (pay-per-use): uncomment and set the key below.
# ANTHROPIC_API_KEY=sk-ant-...

# Data directory for issues and state (default: ~/.local/share/secy)
# SECY_DATA_DIR=${HOME}/.local/share/secy
