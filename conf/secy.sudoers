# /etc/sudoers.d/secy
# Restricted sudo access for AI agent security auditing
#
# Install: sudo cp conf/secy.sudoers /etc/sudoers.d/secy
#          sudo chmod 0440 /etc/sudoers.d/secy
#          sudo visudo -cf /etc/sudoers.d/secy  # validate syntax

# The secy binary must be owned by root and not writable by others
# Install location: /usr/local/bin/secy

# Define the audit command — ONLY the secy wrapper, nothing else
Cmnd_Alias SECY_AUDIT = /usr/local/bin/secy

# Prevent shell escapes from any child process
Defaults!SECY_AUDIT noexec

# Prevent environment variable injection
Defaults!SECY_AUDIT env_reset
Defaults!SECY_AUDIT secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Grant passwordless access to the secy command only
# Replace %secy-audit with the appropriate user/group
%secy-audit ALL=(root) NOPASSWD: SECY_AUDIT
